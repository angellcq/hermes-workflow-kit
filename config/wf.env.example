# wf.env — Hermes Workflow Kit 派单器配置（T-KIT-P2 §2.5）
#
# 用法：复制本文件为同目录 wf.env（scripts/wf_common.py 默认读它），
# 逐键填值。所有键都可被真实环境变量覆盖（优先级：环境变量 > wf.env > 内置缺省）。

# ── 必填 ─────────────────────────────────────────────────────────

# 板名（必填）。派单器守卫①要求全程显式 --board：kanban/current 是全局指针，
# 会随别的项目漂移，曾出现 claim 静默打到别的板。
WF_BOARD=

# 目标 git 仓库绝对路径（必填，产出校验依赖它算快照）。
# Windows 下可写 MSYS 形式（/d/xxx），脚本经 native_path 归一。
WF_REPO=

# ── 工人与派单 ───────────────────────────────────────────────────

# 只派 assignee 以此开头的卡；也是防抢单的机制（真 profile 名会被网关抢单）。
# 传入不带前缀的角色名（如 backend-developer）会被自动补成 cc-backend-developer。
WF_AGENT_PREFIX=cc-

# 全局最大并发 worker 数。哨兵与派单器共享。为什么默认压到 2：cron 自动
# 派单后没有人在旁边盯着，并发冲高时 token 消耗与 git 冲突都失控；2 够用，
# 真要放量再手动调。
WF_MAX_CONCURRENT=2

# 单 agent 最大并发。默认 1：同一 agent 并行干多张卡时改动会互相踩
# （同一批文件的 diff 交叉），先串行跑稳。
WF_MAX_PER_AGENT=1

# 同 agent 两次派单最小间隔秒数（冷却）。推荐 900（=3 个轮询周期）：
# 假执行器零产出被 block→unblock 的回摆周期约 1-2 分钟，冷却太短会
# 立刻重派同一张刚失败的卡；手工派单场景可调回 300。
WF_COOLDOWN_SECONDS=900

# 连续失败熔断阈值：连续 N 次失败后停派该 agent。默认 3：给偶发环境
# 抖动留 1-2 次重试余量，又不至于烧 token 空转。
WF_FAIL_FUSE=3

# 哨兵轮询间隔秒数（cron 调 sentinel_tick.py 的节拍）。默认 300：一个
# worker 轮的典型时长是 5-15 分钟，轮询太密只是白扫板+写 state。
WF_POLL_SECONDS=300

# 子员工名=子目录,逗号分隔（D3 目录域策略；空=仓库根）。
# 例：WF_AGENT_DIRS=front=web/,api=server/
WF_AGENT_DIRS=

# 工作区模式：dir（直接在仓库目录干活）| worktree（一卡一 git worktree）。
WF_WORKSPACE_MODE=dir

# ── claude 调用 ──────────────────────────────────────────────────

# 传给 claude 的附加参数。默认工具白名单必须**逗号分隔**——空格分隔无效，
# 实测会导致工人第一步 Bash 被权限墙拒、静默空转、返回 exit=0 假成功。
WF_CLAUDE_ARGS="--allowedTools Bash,Read,Write,Edit,MultiEdit,Grep,Glob"

# claude 模型覆盖（空=用默认）。
WF_CLAUDE_MODEL=

# 角色真加载开关（T-KIT-P6）。缺省 1：assignee 对应 ~/.claude/agents/<name>.md
# 存在时给 worker 传 --agent，把 cc-* 角色真装进 claude（角色从文本变配置）。
# 强制关闭传 0（只走 TASK.md 文本里的角色名）。文件不存在时自动跳过并留痕，
# 关闭/跳过原因看派单器 stderr 的「角色加载：…」行。
WF_CLAUDE_AGENT_ENABLE=1

# cc-* 角色 agent 定义目录（可覆盖，缺省 ~/.claude/agents）。
# 仅被本地存在性判断使用；先用 scripts/install-claude-agents.sh 装角色再开。
WF_CLAUDE_AGENTS_DIR=

# worker 权限模式。缺省 acceptEdits——缺它时 worker 写文件会在权限墙上等待/被拒，
# 实测表现为 exit=0 但零产出的假成功。不想传该 flag 就填 off。
WF_CLAUDE_PERMISSION_MODE=acceptEdits

# claude 输出 token 上限。claude 默认 2048 会截断长报告并崩，故默认抬到 32000。
WF_MAX_OUTPUT_TOKENS=32000

# ── 产出校验 ─────────────────────────────────────────────────────

# 验证型卡关键词（逗号分隔），只匹配卡**标题**（正文永不参与——修复卡正文
# 天然含这些词，混入正文会把修复卡误判成验证型卡放过零产出）。
WF_VERIFY_KEYWORDS=验收,巡检,复核,盘点,闭环,演练,审计,只读,排查,对照实验

# ── 哨兵状态（T-KIT-P3A）────────────────────────────────────────

# 哨兵 state 落盘路径。空 = <repo>/logs/sentinel_state.json（默认）。
# 为什么必须落盘：cron 每轮都是新进程，内存计数必清零——不落盘就会
# 无限重派同一张失败卡。冷却/熔断计数全靠跨轮持久化。
WF_STATE_FILE=

# 哨兵「死亡判定」秒数：超过该时长未见 state 的 updated_at 刷新，认为
# 哨兵进程已死（pid 僵死/机器重启），允许接管动作。P3A 暂无消费者
# （watchdog 信号在 P3B 实现），先落键位占坑。
WF_SENTINEL_DEAD_SECONDS=900

# ── 运行环境 ─────────────────────────────────────────────────────

# python 解释器。留空=自动探测（Windows 的 python3 可能是 Store 存根，
# 脚本会真跑一次 import 验证，存根会被跳过）。
WF_PYTHON=

# bash 解释器（留空=用当前 shell）。
WF_BASH=

# hermes 可执行（留空=shutil.which 探测，再兜底裸 'hermes'）。
WF_HERMES=
